# Development Dockerfile with hot reload support
FROM golang:1.27.3-alpine@sha256:b8c9b82affbbb82a020bbcf998dad2ba9516944ac7e883524642a481a9505e9c AS development

# Install development tools
RUN apk add --no-cache ca-certificates git tzdata make

# Install Air for hot reload
RUN go install github.com/air-verse/air@v1.67.4

# Install Delve for debugging (optional)
RUN go install github.com/go-delve/delve/cmd/dlv@v1.27.2

# Set working directory
WORKDIR /app

# Copy go mod files
COPY go.mod go.sum ./

# Download dependencies
RUN go mod download

# Copy source code
COPY . .

# Expose ports
EXPOSE 8080 2345

# Default command (can be overridden)
CMD ["air", "-c", ".air.toml"]